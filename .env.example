# Identité de l'instance (toutes optionnelles : les défauts sont ceux du Garage).
# Images (logo, icônes, fonds) : déposer dans un dossier `branding/` à la racine, sous les mêmes
# chemins que `static/` (ex. branding/img/logo.png, branding/img/icons/icon-192.png), il prime sur `static/`.
# BRAND_NAME=Le Garage
# BRAND_COLOR_DARK=#201e1f
# BRAND_COLOR_ACCENT=#80b048
# BRAND_COLOR_ACCENT_DARK=   # si absent mais accent surchargé : accent assombri automatiquement
# Logo et icônes : par défaut un monogramme (initiale du nom) généré aux couleurs du thème.
# BRAND_LOGO=img/logo.png   # chemin sous static/ ou branding/
# BRAND_ICON_DIR=img/icons   # (Garage : voir branding/)  doit contenir favicon-16.png, favicon-32.png, apple-touch-icon.png, icon-192.png, icon-512.png
# Fonds d'écran (accueil, calendrier) : par défaut, dégradé aux couleurs du thème. Pour une photo,
# la déposer dans branding/ et indiquer son chemin sous static/.
# BRAND_HERO_IMAGE=img/accueil.jpg
# BRAND_CALENDAR_IMAGE=img/calendrier.jpg
# BRAND_HOME_TITLE=RESTEZ EN FORME
# BRAND_HOME_TEXT=Venez pratiquer une activité sportive près de chez vous pour améliorer votre forme physique.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC_MEMBRES=change-me

# Paiement manuel par Wero : coordonnées affichées au membre pour régler un carnet
# quand son crédit est épuisé (en attendant l'intégration e-commerce de Wero en France).
RECEPTIONNAIRE_PAIEMENTS_NOM=change-me
RECEPTIONNAIRE_PAIEMENTS_TEL=change-me

# Envoi d'emails (mot de passe oublié). En local, garder le backend console
# (affiche l'email dans le terminal au lieu de l'envoyer).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En prod, utiliser le backend SMTP et renseigner ces variables :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=change-me
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Le Garage <noreply@legarage.fr>

# Sauvegarde hors serveur (voir docs/sauvegardes.md). Nom d'un remote rclone, de préférence chiffré
# (rclone crypt par-dessus Google Drive). Laisser vide pour ne garder que la sauvegarde locale.
# BACKUP_RCLONE_REMOTE=garage-crypt:
# Optionnel : topic ntfy qui reçoit une alerte si l'envoi échoue.
# NTFY_TOPIC_ALERTES=change-me
